{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "email-to-lunchmoney",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-05",
  "observability": {
    "enabled": true,
  },
  "compatibility_flags": [
    "nodejs_als"
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "email-to-lunchmoney",
      "database_id": "afbe28da-7b30-404a-a5c2-a47dace502e9",
    },
  ],
  "vars": {
    "INTERAC_ACCOUNT_MAP": "{\"ATB Financial\":[157428],\"TD Canada Trust\":[157432]}",
    "INTERAC_MODE": "dry-run"
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ],
  },
}